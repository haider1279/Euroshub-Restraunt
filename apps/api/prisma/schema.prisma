generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  phone        String?
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  reservations Reservation[]
  reviews      Review[]
}

model MenuCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  sortOrder Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id            String             @id @default(uuid())
  name          String
  description   String
  price         Decimal            @default(0) @db.Decimal(10, 2)
  imageUrl      String?
  ingredients   String[]           @default([])
  tags          String[]           @default([])
  isAvailable   Boolean            @default(true)
  isFeatured    Boolean            @default(false)
  isPopular     Boolean            @default(false)
  isChefSpecial Boolean            @default(false)
  sortOrder     Int                @default(0)
  categoryId    String
  category      MenuCategory       @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  addonLinks    ProductAddonLink[]
  orderItems    OrderItem[]
  signatureInSettings RestaurantSettings[] @relation("RestaurantSignatureItem")
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([categoryId])
  @@index([isAvailable])
  @@index([deletedAt])
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  product     MenuItem @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

model ProductAddon {
  id          String             @id @default(uuid())
  name        String
  price       Decimal            @db.Decimal(10, 2)
  isAvailable Boolean            @default(true)
  products    ProductAddonLink[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ProductAddonLink {
  id        String       @id @default(uuid())
  productId String
  addonId   String
  product   MenuItem     @relation(fields: [productId], references: [id], onDelete: Cascade)
  addon     ProductAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([productId, addonId])
}

model RestaurantTable {
  id           String        @id @default(uuid())
  tableNumber  String        @unique
  capacity     Int?
  isActive     Boolean       @default(true)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String   @unique
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String
  customer        User        @relation(fields: [customerId], references: [id])
  type            OrderType
  status          OrderStatus @default(PENDING)
  items           OrderItem[]
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)
  deliveryAddress String?
  deliveryNotes   String?
  tableNumber     String?
  contactPhone    String
  paymentMethod   String      @default("PAY_AT_RESTAURANT")
  review          Review?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id                    String    @id @default(uuid())
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId            String?
  menuItem              MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  variantId             String?
  nameAtPurchase        String
  variantNameAtPurchase String?
  priceAtPurchase       Decimal   @db.Decimal(10, 2)
  addonsSnapshot        Json?
  quantity              Int

  @@index([orderId])
}

model Reservation {
  id           String            @id @default(uuid())
  customerId   String
  customer     User              @relation(fields: [customerId], references: [id])
  date         DateTime
  partySize    Int
  tableId      String?
  table        RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableNumber  String?
  contactName  String?
  contactPhone String?
  notes        String?
  status       ReservationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@index([date])
  @@index([customerId])
}

model Review {
  id         String   @id @default(uuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  orderId    String?  @unique
  order      Order?   @relation(fields: [orderId], references: [id])
  rating     Int
  comment    String
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isHidden])
}

model RestaurantSettings {
  id                  String   @id @default("singleton")
  name                String   @default("Euroshub Kitchen")
  headline            String?
  subtitle            String?
  description         String
  phone               String
  email               String
  address             String
  logoUrl             String?
  currency            String   @default("PKR")
  timezone            String   @default("Asia/Karachi")
  openingHours        Json
  deliveryEnabled     Boolean  @default(false)
  deliveryFee         Decimal  @db.Decimal(10, 2) @default(0)
  tableCount          Int      @default(100)
  signatureMenuItemId String?
  signatureMenuItem   MenuItem? @relation("RestaurantSignatureItem", fields: [signatureMenuItemId], references: [id], onDelete: SetNull)
  reservationSettings Json?
  footerText          String?
  updatedAt           DateTime @updatedAt
}
