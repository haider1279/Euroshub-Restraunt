# ===============================================
# EUROSHUB KITCHEN — ENVIRONMENT VARIABLES
# ===============================================

# Database Connection (PostgreSQL / Supabase Postgres Pooler or Direct)
# For local development:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/euroshub_kitchen?schema=public"
# For Supabase production (Transaction / Session pooler):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Backend API Configuration
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# JWT Authentication Secrets (Generate 64+ char random string in production)
JWT_ACCESS_SECRET="euroshub_jwt_access_secret_super_secure_key_2026_change_in_production"
JWT_REFRESH_SECRET="euroshub_jwt_refresh_secret_super_secure_key_2026_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Supabase Storage & Project Configuration (Optional for Cloud Storage)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET_PRODUCTS="product-images"
SUPABASE_STORAGE_BUCKET_LOGO="logo"

# Bootstrap Admin Credentials (For Reference)
# Email: admin@euroshubkitchen.com
# Password: AdminPassword123!
