# ===============================================
# EUROSHUB KITCHEN - ENVIRONMENT VARIABLES (EXAMPLE)
# Copy this file to .env and fill in real values.
# Never put real passwords or keys in this file.
# ===============================================

# Database (Supabase -> Connect)
DATABASE_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"

# Server
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# JWT (min 32 chars each, must be different)
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_ACCESS_SECRET="<generate-secret-1>"
JWT_REFRESH_SECRET="<generate-secret-2>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Supabase (Project Settings -> API)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<supabase-publishable-key>"
SUPABASE_SERVICE_ROLE_KEY="<supabase-secret-key>"
SUPABASE_STORAGE_BUCKET_PRODUCTS="product-images"
SUPABASE_STORAGE_BUCKET_LOGO="logo"

# Admin
ADMIN_SEED_PASSWORD="<strong-admin-password>"